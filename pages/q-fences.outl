      "indent": 0,
      "content_hash": "sha256:5447cd2410398b93b26e7e601e96b2b8f4f1d558d457d8cf122da682ee4704a1",
      "ref_handle": "blk-mccfkz",
      "text": "EXPECT: empty — a positive and its exact negation can never both hold, for every key."
    },
    {
      "id": "01M4SF0EE6T14S47TJ1WVM339A",
      "line": 92,
      "indent": 0,
      "content_hash": "sha256:edcae8126ecdcb2f801741c0be4e510d7f429cca1de9be41213063893374c12a",
      "ref_handle": "blk-vm339a",
      "text": "Controls have no negative: sort and limit are not filters, so the not- wrapper is rejected as an unknown key rather than silently ignored."
    },
