      "line": 89,
      "indent": 0,
      "content_hash": "sha256:269d390d8bd9bd08dc939474e829ac3f743e9c42a05c7f5b0378832b0d1a7639",
      "ref_handle": "blk-85kgkq",
      "text": "```query\nstatus: open\nnot-status: open\n```"
    },
