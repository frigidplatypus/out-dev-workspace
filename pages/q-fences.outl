      "line": 49,
      "indent": 0,
      "content_hash": "sha256:4235455e9a23cd32262caba9ff49b9f981d7ddb976a94e228d825d15534ee87a",
      "ref_handle": "blk-mmm8nm",
      "text": "Negation combined with a state filter and windowing: todo blocks that do not carry #jedi, ordered by text, cut to the first three."
    },
    {
